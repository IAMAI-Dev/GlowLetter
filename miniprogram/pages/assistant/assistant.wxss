.assistant-shell { width: 100%; height: calc(100vh - var(--custom-nav-height)); display: flex; flex-direction: column; overflow: hidden; background: var(--color-bg); }
.assistant-scroll { flex: 1; width: 100%; height: 0; min-height: 0; }
.assistant-content { padding: 32rpx 36rpx 44rpx; }
.assistant-record { padding: 36rpx; border-left: 8rpx solid var(--color-accent); background: var(--color-fg); color: var(--color-bg); border-radius: 0 32rpx 32rpx 0; }
.assistant-record .eyebrow { color: var(--color-accent); }
.assistant-sample { display: block; margin: 16rpx 0; overflow-wrap: anywhere; }
.record-meta { display: flex; flex-wrap: wrap; gap: 12rpx 28rpx; font: 22rpx var(--font-mono); opacity: .72; }
.assistant-notice { margin-top: 24rpx; padding: 24rpx; font-size: 23rpx; }
.provider-label { display: block; margin-top: 12rpx; overflow-wrap: anywhere; }
.assistant-intro { display: block; margin: 32rpx 0 20rpx; font-size: 28rpx; }
.task-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 28rpx; }
.task-button { flex: 1 1 180rpx; display: flex; align-items: center; gap: 14rpx; margin: 0; padding: 22rpx; border: 1rpx solid var(--color-border); border-radius: 20rpx; background: var(--color-surface); font-size: 25rpx; line-height: 1.4; text-align: left; }
.task-mark { color: #276c32; font: 32rpx var(--font-mono); }
.conversation { display: flex; flex-direction: column; gap: 24rpx; }
.message { padding: 28rpx; border: 1rpx solid var(--color-border); border-radius: 24rpx; background: var(--color-surface); }
.message-user { margin-left: 44rpx; background: #e8eddf; border-color: transparent; }
.message-assistant { margin-right: 12rpx; border-left: 4rpx solid #4b7b50; }
.message-header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx; margin-bottom: 18rpx; font-size: 21rpx; color: var(--color-muted); }
.message-text { display: block; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 28rpx; line-height: 1.7; }
.message-evidence { display: block; margin-top: 20rpx; padding-top: 14rpx; border-top: 1rpx solid var(--color-border); color: var(--color-muted); font-size: 22rpx; }
.copy-button { margin: 20rpx 0 0 auto; padding: 8rpx 18rpx; width: auto; background: transparent; color: var(--color-muted); font-size: 23rpx; line-height: 1.5; }
.report-draft { margin-top: 32rpx; padding: 30rpx; background: var(--color-surface); border: 1rpx solid var(--color-border); border-top: 5rpx solid var(--color-fg); }
.report-text { margin: 24rpx 0; }
.assistant-error { margin: 24rpx 0; border-color: #b48275; }
.assistant-wait { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 12rpx; color: var(--color-muted); font-size: 25rpx; }
.waiting-dot { width: 12rpx; height: 12rpx; flex: none; border-radius: 50%; background: #397d43; }
.context-hint { display: block; margin-top: 28rpx; font-size: 22rpx; }
.composer { flex-shrink: 0; width: 100%; display: flex; align-items: flex-end; gap: 16rpx; padding: 20rpx 28rpx max(24rpx, env(safe-area-inset-bottom)); border-top: 1rpx solid var(--color-border); background: var(--color-bg); }
.composer-keyboard { padding-bottom: 16rpx; }
.composer-field { flex: 1; min-width: 0; overflow: hidden; padding: 16rpx; background: #f1f2e9; border-radius: 16rpx; }
.composer-input { display: block; width: 100%; padding: 0; margin: 0; font-size: 28rpx; line-height: 22px; color: var(--color-fg); background: #f1f2e9; }
.send-button { min-height: 76rpx; padding: 16rpx 22rpx; font-size: 26rpx; flex: none; }
.block { display: block; margin: 24rpx 0; }
