<custom-navbar title="{{copy.preparingResults}}" dark="{{true}}" />

<view class="page page-enter page-dark no-tabs analyzing-page">
  <view wx:if="{{!hasError}}">
    <view class="analysis-orbit" aria-hidden="true">
      <view class="analysis-ring"></view>
      <view class="analysis-ring-inner"></view>
      <image class="analysis-image" src="/assets/images/fluorescence-plate-demo.png" mode="aspectFill" />
    </view>
    <text class="eyebrow center analysis-eyebrow">{{copy.demoDuration}}</text>
    <text class="heading-2 center analysis-title">{{copy.analysisTitle}}</text>
    <view class="analysis-list analysis-steps" aria-live="polite">
      <view
        wx:for="{{steps}}"
        wx:key="*this"
        class="analysis-step {{index < activeIndex ? 'analysis-step-done' : ''}} {{index === activeIndex ? 'analysis-step-active' : ''}}"
      >
        <view class="analysis-dot"></view>
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="card card-dark analysis-error-card">
    <text class="eyebrow">{{copy.notCompleted}}</text>
    <text class="heading-2 error-title">{{copy.analysisUnavailable}}</text>
    <text class="lead error-lead">{{copy.analysisRetryHelp}}</text>
    <view class="button-group">
      <button class="btn btn-primary" bindtap="retryAnalysis">{{copy.reanalyze}}</button>
      <button class="btn btn-secondary" bindtap="returnToImage">{{copy.backImage}}</button>
    </view>
  </view>
</view>

<route-transition active="{{routeTransitioning}}" tone="{{routeTransitionTone || 'light'}}" />
