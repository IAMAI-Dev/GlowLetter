<view class="main-shell" data-current-tab="{{activeTab}}">
  <scroll-view
    class="main-scroll {{activeTab === 'home' ? 'is-active' : ''}}"
    hidden="{{activeTab !== 'home'}}"
    scroll-y
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    lower-threshold="12"
    bindscroll="handleTabScroll"
    bindscrolltolower="handleTabScrollToLower"
  >
    <view class="page page-enter tab-page home-page {{activeTab === 'home' ? 'tab-page-active' : ''}}">
      <view class="top-hero home-hero" style="padding-top: calc({{statusBarHeight}}px + 56rpx);">
        <view class="row-between">
          <image class="team-lockup-mark" src="/assets/images/team-logo.png" mode="aspectFit" aria-label="{{copy.teamLogo}}" />
          <view class="version-pill">
            <view class="version-dot"></view>
            <text>{{copy.demoVersion}}</text>
          </view>
        </view>
        <text class="eyebrow home-eyebrow">{{copy.brand}}</text>
        <text class="heading-1 home-title">{{copy.heroTitle}}</text>
        <text class="lead home-lead">{{copy.heroDescription}}</text>
        <view class="hero-visual">
          <image class="hero-image" src="/assets/images/fluorescence-plate-demo.png" mode="aspectFill" aria-label="{{copy.plateAlt}}" />
          <view class="hero-caption">
            <text>{{copy.plateDemo}}</text>
          </view>
        </view>
      </view>

      <view class="section home-primary-actions">
        <view class="button-group home-button-group">
          <button class="btn btn-primary btn-block" bindtap="startDetection">
            <text>{{copy.start}}</text>
            <text class="button-arrow">→</text>
          </button>
          <button class="btn btn-secondary btn-block" bindtap="openHistory">{{copy.viewHistory}}</button>
        </view>
      </view>

      <view class="section section-bordered">
        <view class="section-title">
          <text class="heading-2">{{copy.learnMore}}</text>
          <text class="section-title-desc">{{copy.learnDescription}}</text>
        </view>
        <view class="quick-grid">
          <view class="quick-card" role="button" aria-label="{{copy.about}}" bindtap="openAbout">
            <view class="quick-symbol quick-symbol-info">i</view>
            <text class="quick-card-title">{{copy.about}}</text>
          </view>
          <view class="quick-card" role="button" aria-label="{{copy.profile}}" bindtap="openProfile">
            <view class="quick-symbol quick-symbol-profile">
              <view class="quick-profile-head"></view>
              <view class="quick-profile-body"></view>
            </view>
            <text class="quick-card-title">{{copy.profile}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <scroll-view
    class="main-scroll {{activeTab === 'history' ? 'is-active' : ''}}"
    hidden="{{activeTab !== 'history'}}"
    scroll-y
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    lower-threshold="12"
    refresher-enabled="{{true}}"
    refresher-triggered="{{historyRefreshing}}"
    bindrefresherrefresh="handleHistoryRefresh"
    bindscroll="handleTabScroll"
    bindscrolltolower="handleTabScrollToLower"
  >
    <custom-navbar
      title="{{copy.historyTitle}}"
      emit-back="{{true}}"
      action="refresh"
      action-label="{{copy.refreshHistory}}"
      bind:backrequest="showHomeTab"
      bind:action="handleNavbarAction"
    />

    <view class="page page-enter tab-page history-page {{activeTab === 'history' ? 'tab-page-active' : ''}}">
      <view>
        <text class="eyebrow">{{copy.privateHistory}}</text>
        <view class="row-between history-summary-row">
          <view class="grow">
            <text class="heading-2 history-title">{{copy.recordTrail}}</text>
            <text class="lead history-lead">{{copy.historyDescription}}</text>
          </view>
          <text class="meta"><text class="num">{{total}}</text> {{copy.recordCount}}</text>
        </view>
      </view>

      <view class="section">
        <view wx:if="{{historyLoading && !records.length}}" class="empty-state">
          <text class="heading-3 empty-title">{{copy.historyLoading}}</text>
          <text class="muted empty-desc">{{copy.historySync}}</text>
        </view>

        <view wx:elif="{{historyError && !records.length}}" class="empty-state">
          <text class="heading-3 empty-title">{{copy.historyUnavailable}}</text>
          <text class="muted empty-desc">{{historyError}}</text>
          <button class="btn btn-primary empty-action" bindtap="handleNavbarAction">{{copy.reload}}</button>
        </view>

        <view wx:elif="{{records.length}}" class="record-list">
          <view
            wx:for="{{records}}"
            wx:key="id"
            class="record-card"
            data-id="{{item.id}}"
            role="button"
            aria-label="{{copy.viewRecords}} {{item.sampleName}}"
            bindtap="openDetail"
          >
            <view class="row-between">
              <view>
                <text class="meta record-time">{{item.timeLabel}}</text>
                <text class="heading-3 record-name">{{item.sampleName}}</text>
              </view>
            </view>
            <text class="record-reading">{{item.result.concentration}}<text class="record-unit"> {{item.result.unit}}</text></text>
            <view class="record-tags">
              <text class="tag">{{copy.grade}} {{item.result.gradeCode}} · {{item.resultView.gradeLabel}}</text>
              <text class="tag">{{item.result.rangeLabel}}</text>
            </view>
          </view>
        </view>

        <view wx:else class="empty-state">
          <view class="empty-clock" aria-hidden="true">
            <view class="empty-clock-hour"></view>
            <view class="empty-clock-minute"></view>
          </view>
          <text class="heading-3 empty-title">{{copy.emptyHistory}}</text>
          <text class="muted empty-desc">{{copy.emptyHistoryDescription}}</text>
          <button class="btn btn-primary empty-action" bindtap="startDetection">{{copy.firstDetection}}</button>
        </view>

        <view wx:if="{{historyError && records.length}}" class="notice history-error-notice">{{historyError}}</view>
        <button wx:if="{{hasMore}}" class="btn btn-secondary btn-block load-more" loading="{{historyLoadingMore}}" disabled="{{historyLoadingMore}}" bindtap="loadMore">{{historyLoadingMore ? copy.loading : copy.loadMore}}</button>
      </view>

      <view class="section section-bordered">
        <view class="notice">{{cloudMode ? copy.cloudIsolation : copy.localIsolation}}</view>
      </view>
    </view>
  </scroll-view>

  <scroll-view
    class="main-scroll {{activeTab === 'profile' ? 'is-active' : ''}}"
    hidden="{{activeTab !== 'profile'}}"
    scroll-y
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    lower-threshold="12"
    bindscroll="handleTabScroll"
    bindscrolltolower="handleTabScrollToLower"
  >
    <custom-navbar title="{{copy.profile}}" emit-back="{{true}}" bind:backrequest="showHomeTab" />

    <view class="page page-enter tab-page profile-page {{activeTab === 'profile' ? 'tab-page-active' : ''}}">
      <view class="profile-hero">
        <view class="avatar">
          <image class="avatar-image" src="/assets/images/team-logo.png" mode="aspectFit" aria-label="{{copy.teamAvatar}}" />
        </view>
        <view class="grow">
          <text class="heading-2 profile-name">{{copy.visitor}}</text>
          <view class="profile-status">
            <view class="version-pill"><view class="version-dot"></view><text>{{identityLabel}}</text></view>
          </view>
        </view>
      </view>

      <view class="section section-bordered">
        <view class="card card-dark row-between count-card">
          <view>
            <text class="meta count-label">{{copy.detectionCount}}</text>
            <text class="result-number count-number">{{recordCount}}</text>
          </view>
          <button class="btn btn-primary" bindtap="openHistory">{{copy.viewRecords}}</button>
        </view>
      </view>

      <view class="section section-bordered">
        <view class="section-title"><text class="heading-2">{{copy.settings}}</text></view>
        <view class="menu-list">
          <button class="menu-item" bindtap="chooseLanguage"><text>{{copy.language}}</text><text class="language-value">{{locale === 'en' ? 'English' : '简体中文'}} ›</text></button>
          <button class="menu-item" bindtap="openAbout"><text>{{copy.aboutMenu}}</text><text class="menu-arrow">›</text></button>
          <button class="menu-item" bindtap="openPrivacy"><text>{{copy.privacy}}</text><text class="menu-arrow">›</text></button>
          <button class="menu-item" bindtap="clearAiConversations"><text>{{copy.aiClearAll}}</text><text class="menu-arrow">›</text></button>
          <button class="menu-item menu-item-last" bindtap="clearCache"><text>{{copy.clearCache}}</text><text class="menu-arrow">›</text></button>
        </view>
      </view>

      <view class="section section-bordered">
        <view class="notice">{{cloudMode ? copy.cloudPrivacy : copy.offlinePrivacy}}</view>
      </view>
    </view>
  </scroll-view>

  <custom-tabbar active="{{activeTab}}" docked="{{tabbarDocked}}" bind:select="handleTabChange" />
  <route-transition active="{{routeTransitioning}}" tone="{{routeTransitionTone || 'light'}}" />
</view>
