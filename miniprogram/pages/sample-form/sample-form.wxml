<custom-navbar title="{{copy.sampleForm}}" />

<view class="page page-enter no-tabs sample-page">
  <view>
    <view class="progress-line" aria-label="{{copy.stepOneAlt}}">
      <view class="progress-step progress-step-current"></view>
      <view class="progress-step"></view>
      <view class="progress-step"></view>
    </view>
    <text class="eyebrow">{{copy.stepOne}}</text>
    <text class="heading-2 intro-title">{{copy.nameDetection}}</text>
    <text class="lead intro-lead">{{copy.sampleNameHelp}}</text>
  </view>

  <form class="section stack sample-fields" bindsubmit="handleSubmit">
    <view class="field {{nameInvalid ? 'field-invalid' : ''}}">
      <text class="field-label">{{copy.sampleName}}</text>
      <input
        class="input"
        value="{{draft.sampleName}}"
        data-field="sampleName"
        maxlength="40"
        placeholder="{{copy.exampleSample}}"
        placeholder-class="input-placeholder"
        bindinput="onInput"
      />
      <text class="field-help num">{{nameCount}} / 40</text>
      <text class="field-error">{{copy.sampleNameValidation}}</text>
    </view>

    <view class="field">
      <text class="field-label">{{copy.sampleNote}} <text class="optional">{{copy.optional}}</text></text>
      <textarea
        class="textarea"
        value="{{draft.note}}"
        data-field="note"
        maxlength="200"
        auto-height="false"
        placeholder="{{copy.sampleNotePlaceholder}}"
        placeholder-class="input-placeholder"
        bindinput="onInput"
      ></textarea>
      <text class="field-help num">{{noteCount}} / 200</text>
    </view>

    <view class="field">
      <text class="field-label">{{copy.plateId}} <text class="optional">{{copy.optional}}</text></text>
      <input class="input" value="{{draft.plateId}}" data-field="plateId" maxlength="40" placeholder="{{copy.examplePlate}}" placeholder-class="input-placeholder" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="field-label">{{copy.batchId}} <text class="optional">{{copy.optional}}</text></text>
      <input class="input" value="{{draft.batchId}}" data-field="batchId" maxlength="40" placeholder="{{copy.exampleBatch}}" placeholder-class="input-placeholder" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="field-label">{{copy.operatorNote}} <text class="optional">{{copy.optional}}</text></text>
      <input class="input" value="{{draft.operatorNote}}" data-field="operatorNote" maxlength="80" placeholder="{{copy.operatorPlaceholder}}" placeholder-class="input-placeholder" bindinput="onInput" />
    </view>

    <view class="notice">{{copy.draftPrivacy}}</view>
    <button class="btn btn-primary btn-block" form-type="submit">{{copy.nextImage}}</button>
  </form>
</view>

<route-transition active="{{routeTransitioning}}" tone="{{routeTransitionTone || 'light'}}" />
