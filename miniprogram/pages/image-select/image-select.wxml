<custom-navbar title="{{copy.chooseFluorescence}}" />

<view class="page page-enter no-tabs image-page">
  <view>
    <view class="progress-line" aria-label="{{copy.stepTwoAlt}}">
      <view class="progress-step progress-step-done"></view>
      <view class="progress-step progress-step-current"></view>
      <view class="progress-step"></view>
    </view>
    <text class="eyebrow">{{copy.stepTwo}}</text>
    <text class="heading-2 intro-title">{{copy.importPlate}}</text>
    <text class="lead intro-lead">{{copy.imageFormats}}</text>
  </view>

  <view class="section">
    <view wx:if="{{!hasImage}}" class="upload-zone">
      <view class="upload-content">
        <view class="upload-picture-icon" aria-hidden="true">
          <view class="upload-sun"></view>
          <view class="upload-mountain"></view>
        </view>
        <text class="heading-3 upload-title">{{copy.noImage}}</text>
        <text class="muted upload-desc">{{copy.chooseImageHelp}}</text>
        <view class="button-group upload-actions">
          <button class="btn btn-secondary" loading="{{selecting}}" disabled="{{selecting}}" bindtap="chooseImage">{{copy.fromDevice}}</button>
          <button class="btn btn-quiet" bindtap="useDemoImage">{{copy.useDemoImage}}</button>
        </view>
      </view>
    </view>

    <view wx:else>
      <view class="preview-frame">
        <image class="preview-image" src="{{imagePath}}" mode="aspectFill" aria-label="{{copy.previewAlt}}" />
        <text class="preview-tag">{{copy.demoFlow}}</text>
      </view>
      <view class="file-meta" aria-label="{{copy.imageInfo}}">
        <view class="file-meta-item">
          <text class="file-meta-label">{{copy.format}}</text>
          <text class="file-meta-value">{{imageMeta.format}}</text>
        </view>
        <view class="file-meta-item">
          <text class="file-meta-label">{{copy.dimensions}}</text>
          <text class="file-meta-value">{{imageMeta.width}} × {{imageMeta.height}}</text>
        </view>
        <view class="file-meta-item">
          <text class="file-meta-label">{{copy.size}}</text>
          <text class="file-meta-value">{{imageMeta.sizeLabel || copy.unknown}}</text>
        </view>
      </view>
      <button class="btn btn-quiet btn-block reselect-button" loading="{{selecting}}" disabled="{{selecting}}" bindtap="chooseImage">{{copy.reselectImage}}</button>
    </view>
  </view>

  <view class="section section-bordered image-confirm">
    <view class="notice">{{copy.imagePrivacy}}</view>
    <button class="btn btn-primary btn-block confirm-button" disabled="{{!hasImage}}" bindtap="confirmImage">{{copy.confirmImage}}</button>
  </view>
</view>

<route-transition active="{{routeTransitioning}}" tone="{{routeTransitionTone || 'light'}}" />
