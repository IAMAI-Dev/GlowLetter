<custom-navbar title="{{copy.about}}" />

<view class="page page-enter no-tabs about-page">
  <view class="top-hero about-hero">
    <text class="eyebrow">{{copy.aboutEyebrow}}</text>
    <text class="heading-1 about-title">{{copy.aboutTitle}}</text>
    <text class="lead about-lead">{{copy.aboutDescription}}</text>
  </view>

  <view class="section">
    <view class="section-title">
      <text class="heading-2">{{copy.detectionConcept}}</text>
    </view>
    <view class="timeline">
      <view class="timeline-item">
        <view class="timeline-rail"><view class="timeline-line"></view><view class="timeline-dot"></view></view>
        <view class="timeline-content"><text class="timeline-title">{{copy.samplePreparation}}</text><text class="timeline-desc">{{copy.incubation}}</text></view>
      </view>
      <view class="timeline-item">
        <view class="timeline-rail"><view class="timeline-line"></view><view class="timeline-dot"></view></view>
        <view class="timeline-content"><text class="timeline-title">{{copy.darkBox}}</text><text class="timeline-desc">{{copy.darkBoxDescription}}</text></view>
      </view>
      <view class="timeline-item">
        <view class="timeline-rail"><view class="timeline-line"></view><view class="timeline-dot"></view></view>
        <view class="timeline-content"><text class="timeline-title">{{copy.modelInterface}}</text><text class="timeline-desc">{{copy.modelInterfaceDescription}}</text></view>
      </view>
      <view class="timeline-item timeline-item-last">
        <view class="timeline-rail"><view class="timeline-dot"></view></view>
        <view class="timeline-content"><text class="timeline-title">{{copy.futureOutputs}}</text><text class="timeline-desc">{{copy.futureOutputsDescription}}</text></view>
      </view>
    </view>
  </view>

  <view class="section section-bordered">
    <view class="card card-dark">
      <text class="eyebrow stage-eyebrow">{{copy.developmentStage}}</text>
      <text class="heading-2 stage-title">{{copy.stageTitle}}</text>
      <text class="lead stage-lead">{{copy.stageDescription}}</text>
      <view class="version-pill stage-version"><text>0.3.0</text></view>
    </view>
  </view>

  <view class="section section-bordered">
    <view class="section-title"><text class="heading-2">{{copy.usageSteps}}</text></view>
    <view class="card data-list">
      <view class="data-row"><text class="data-label num">01</text><text class="data-value">{{copy.fillSample}}</text></view>
      <view class="data-row"><text class="data-label num">02</text><text class="data-value">{{copy.selectPlate}}</text></view>
      <view class="data-row"><text class="data-label num">03</text><text class="data-value">{{copy.startAnalysis}}</text></view>
      <view class="data-row data-row-last"><text class="data-label num">04</text><text class="data-value">{{copy.viewSave}}</text></view>
    </view>
  </view>

  <view class="section section-bordered" id="privacy">
    <view class="section-title"><text class="heading-2">{{copy.dataPrivacy}}</text></view>
    <view class="stack">
      <view class="inset-card"><text class="privacy-title">{{copy.collectedData}}</text><text class="muted privacy-desc">{{copy.collectedDescription}}</text></view>
      <view class="inset-card"><text class="privacy-title">{{copy.purpose}}</text><text class="muted privacy-desc">{{copy.purposeDescription}}</text></view>
      <view class="inset-card"><text class="privacy-title">{{copy.deletion}}</text><text class="muted privacy-desc">{{copy.deletionDescription}}</text></view>
      <view class="inset-card"><text class="privacy-title">{{copy.aiPrivacyTitle}}</text><text class="muted privacy-desc">{{copy.aiDisclosure}}</text></view>
    </view>
  </view>

  <view class="section section-bordered">
    <view class="section-title"><text class="heading-2">{{copy.disclaimer}}</text></view>
    <view class="notice">{{copy.fullDisclaimer}}</view>
  </view>

  <view class="section section-bordered">
    <view class="section-title">
      <text class="heading-2">{{copy.team}}</text>
      <text class="section-title-desc">{{copy.teamPending}}</text>
    </view>
    <view class="card card-dark team-lockup">
      <image class="team-lockup-mark" src="/assets/images/team-logo.png" mode="aspectFit" aria-label="{{copy.teamLogo}}" />
      <view class="grow">
        <image class="team-lockup-wordmark" src="/assets/images/team-wordmark.png" mode="widthFix" aria-label="{{copy.teamWordmark}}" />
        <text class="muted team-desc">{{copy.teamDescription}}</text>
      </view>
    </view>
    <button class="btn btn-primary btn-block return-home" bindtap="returnHome">{{copy.returnHome}}</button>
  </view>
</view>

<route-transition active="{{routeTransitioning}}" tone="{{routeTransitionTone || 'light'}}" />
