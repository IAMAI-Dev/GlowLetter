<custom-navbar
  title="{{copy.resultTitle}}"
  back-route="/pages/home/home"
  action="info"
  action-label="{{copy.resultInfo}}"
  bind:action="handleNavbarAction"
/>

<view class="page page-enter no-tabs result-page">
  <view>
    <view class="demo-banner">
      <view class="demo-warning">!</view>
      <text>{{copy.resultDisclaimer}}</text>
    </view>
    <view class="result-hero">
      <view class="row-between">
        <view>
          <text class="meta result-meta">{{copy.sample}}</text>
          <text class="heading-3 result-sample">{{draft.sampleName || 'A01'}}</text>
        </view>
        <text class="meta">{{timeLabel}}</text>
      </view>
      <text class="result-number">{{result.concentration}}<text class="result-unit">{{result.unit}}</text></text>
      <text class="result-caption">{{resultView.pollutant}} · {{copy.simulatedConcentration}}</text>
      <view class="grade-chip">
        <text class="grade-strong">{{copy.grade}} {{result.gradeCode}}</text>
        <text>·</text>
        <text>{{resultView.gradeLabel}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text class="heading-2">{{copy.fluorescenceImage}}</text>
    </view>
    <view class="preview-frame">
      <image class="preview-image" src="{{imagePath}}" mode="aspectFill" aria-label="{{copy.resultImageAlt}}" />
      <text class="preview-tag">{{copy.demoImage}}</text>
    </view>
  </view>

  <view class="section section-bordered">
    <view class="section-title">
      <text class="heading-2">{{copy.resultDetails}}</text>
    </view>
    <view class="card data-list">
      <view class="data-row"><text class="data-label">{{copy.simulatedRange}}</text><text class="data-value num">{{result.rangeLabel}}</text></view>
      <view class="data-row"><text class="data-label">{{copy.pollutionGrade}}</text><text class="data-value">{{copy.grade}} {{result.gradeCode}}</text></view>
      <view class="data-row"><text class="data-label">{{copy.gradeLabel}}</text><text class="data-value">{{resultView.gradeLabel}}</text></view>
      <view class="data-row"><text class="data-label">{{copy.dataSource}}</text><text class="data-value">{{dataSourceLabel}}</text></view>
      <view class="data-row"><text class="data-label">{{copy.modelVersion}}</text><text class="data-value num">{{result.modelVersion}}</text></view>
      <view class="data-row data-row-last"><text class="data-label">{{copy.retest}}</text><text class="data-value">{{result.retestRecommended ? copy.yes : copy.no}}</text></view>
    </view>
  </view>

  <view class="section section-bordered">
    <view class="section-title"><text class="heading-2">{{copy.guidance}}</text></view>
    <view class="card"><text>{{resultView.suggestion}}</text></view>
  </view>

  <view class="section section-bordered">
    <view class="button-group result-actions">
      <view wx:if="{{saveError}}" class="notice result-save-error">{{saveError}}</view>
      <button class="btn btn-primary btn-block" loading="{{saving}}" disabled="{{saving || saved}}" bindtap="saveRecord">{{saved ? copy.saved : (saving ? copy.saving : copy.saveRecord)}}</button>
      <button class="btn btn-secondary btn-block" disabled="{{saving}}" bindtap="openAssistant">{{copy.aiTitle}} →</button>
      <view class="button-group button-group-two result-secondary-actions">
        <button class="btn btn-secondary" bindtap="restartDetection">{{copy.restart}}</button>
        <button class="btn btn-secondary" bindtap="returnHome">{{copy.returnHome}}</button>
      </view>
    </view>
  </view>
</view>

<route-transition active="{{routeTransitioning}}" tone="{{routeTransitionTone || 'light'}}" />
