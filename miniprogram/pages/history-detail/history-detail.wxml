<custom-navbar
  title="{{copy.detailTitle}}"
  back-route="/pages/home/home?tab=history"
  action="{{hasRecord ? 'delete' : ''}}"
  action-label="{{copy.deleteRecord}}"
  bind:action="handleNavbarAction"
/>

<view class="page page-enter no-tabs detail-page">
  <view wx:if="{{loading}}" class="empty-state detail-empty">
    <text class="heading-3 empty-title">{{copy.readingRecord}}</text>
    <text class="muted empty-desc">{{copy.readingRecordHelp}}</text>
  </view>

  <view wx:elif="{{hasRecord}}">
    <view class="result-hero">
      <view class="row-between">
        <view>
          <text class="meta detail-meta">{{copy.sample}}</text>
          <text class="heading-3 detail-sample">{{record.sampleName}}</text>
        </view>
        <text class="meta">{{timeLabel}}</text>
      </view>
      <text class="result-number">{{record.result.concentration}}<text class="result-unit">{{record.result.unit}}</text></text>
      <text class="detail-caption">{{record.resultView.pollutant}} · {{copy.simulatedConcentration}}</text>
      <view class="grade-chip">
        <text class="grade-strong">{{copy.grade}} {{record.result.gradeCode}}</text>
        <text>·</text>
        <text>{{record.resultView.gradeLabel}}</text>
      </view>
    </view>

    <view class="section">
      <view class="preview-frame">
        <image class="preview-image" src="{{record.imagePath}}" mode="aspectFill" aria-label="{{copy.historyImageAlt}}" />
        <text class="preview-tag">{{copy.savedImage}}</text>
      </view>
    </view>

    <view class="section section-bordered">
      <view class="section-title">
        <text class="heading-2">{{copy.recordInfo}}</text>
        <text class="section-title-desc">{{copy.recordImmutable}}</text>
      </view>
      <view class="card data-list">
        <view class="data-row"><text class="data-label">{{copy.simulatedRange}}</text><text class="data-value num">{{record.result.rangeLabel}}</text></view>
        <view class="data-row"><text class="data-label">{{copy.pollutionGrade}}</text><text class="data-value">{{copy.grade}} {{record.result.gradeCode}} · {{record.resultView.gradeLabel}}</text></view>
        <view class="data-row"><text class="data-label">{{copy.dataSource}}</text><text class="data-value">{{record.dataSourceLabel}}</text></view>
        <view class="data-row"><text class="data-label">{{copy.modelVersion}}</text><text class="data-value num">{{record.result.modelVersion}}</text></view>
        <view class="data-row data-row-last"><text class="data-label">{{copy.guidance}}</text><text class="data-value">{{copy.guidancePending}}</text></view>
      </view>
      <view class="notice detail-notice">{{copy.recordDisclaimer}}</view>
    </view>

    <view class="section section-bordered">
      <view class="button-group button-group-two detail-actions">
        <button class="btn btn-primary" bindtap="reuseSample">{{copy.reuseSample}}</button>
        <button class="btn btn-secondary" bindtap="returnHistory">{{copy.returnHistory}}</button>
      </view>
      <button class="btn btn-secondary btn-block assistant-entry" disabled="{{deleting}}" bindtap="openAssistant">{{copy.aiTitle}} →</button>
      <button class="btn btn-danger btn-block delete-button" loading="{{deleting}}" disabled="{{deleting}}" bindtap="confirmDelete">{{deleting ? copy.deleting : copy.deleteRecord}}</button>
    </view>
  </view>

  <view wx:elif="{{loadError}}" class="empty-state detail-empty">
    <text class="heading-3 empty-title">{{copy.recordUnavailable}}</text>
    <text class="muted empty-desc">{{loadError}}</text>
    <button class="btn btn-primary empty-action" bindtap="retryLoad">{{copy.reload}}</button>
  </view>

  <view wx:else class="empty-state detail-empty">
    <text class="heading-3 empty-title">{{copy.recordMissing}}</text>
    <text class="muted empty-desc">{{copy.recordMissingHelp}}</text>
    <button class="btn btn-primary empty-action" bindtap="returnHistory">{{copy.returnHistory}}</button>
  </view>
</view>

<route-transition active="{{routeTransitioning}}" tone="{{routeTransitionTone || 'light'}}" />
