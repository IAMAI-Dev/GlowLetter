<view class="launch page-enter">
  <view class="brand-mark brand-mark-logo launch-logo" aria-hidden="true">
    <image class="brand-image" src="/assets/images/team-logo.png" mode="aspectFit" />
  </view>
  <text class="eyebrow launch-eyebrow">{{copy.igemDemo}}</text>
  <text class="heading-1 launch-title">{{copy.appName}}</text>
  <text class="lead launch-lead">{{copy.launchDescription}}</text>
  <view class="launch-status" aria-live="polite">
    <view class="status-dot"></view>
    <text>{{statusText}}</text>
  </view>
  <view wx:if="{{hasError}}" class="button-group launch-actions">
    <button class="btn btn-primary btn-block" disabled="{{initializing}}" bindtap="handleRetry">{{copy.retry}}</button>
    <button class="btn btn-secondary btn-block" bindtap="enterDemo">{{copy.enterOffline}}</button>
  </view>
</view>

<route-transition active="{{routeTransitioning}}" tone="{{routeTransitionTone || 'light'}}" />
